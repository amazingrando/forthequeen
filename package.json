{
  "name": "for-the-queen-srd",
  "version": "1.0.0",
  "private": true,
  "description": "For the Queen SRD",
  "author": "Randy Oest",
  "keywords": [
    "gatsby"
  ],
  "scripts": {
    "dev": "gatsby develop",
    "develop": "gatsby develop",
    "start": "gatsby develop",
    "build": "gatsby build",
    "serve": "gatsby serve",
    "clean": "gatsby clean",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint src plugins gatsby-config.js gatsby-node.js gatsby-browser.js setup-google-sheets.js",
    "lint:fix": "ESLINT_USE_FLAT_CONFIG=false eslint src plugins gatsby-config.js gatsby-node.js gatsby-browser.js setup-google-sheets.js --fix",
    "setup-google-sheets": "node setup-google-sheets.js",
    "serve:static": "gatsby serve -p 9000",
    "check-links": "npm run build && start-server-and-test serve:static http://localhost:9000 check-links:crawl",
    "check-links:crawl": "linkinator http://localhost:9000 --recurse --skip '^(mailto:|tel:|javascript:)'"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@fortawesome/fontawesome-pro": "^7.3.1",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/pro-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@google-cloud/local-auth": "^3.0.1",
    "dotenv": "^18.0.4",
    "gatsby": "^5.16.1",
    "gatsby-plugin-emotion": "^8.16.0",
    "gatsby-plugin-google-analytics": "^5.16.0",
    "gatsby-source-filesystem": "^5.16.0",
    "gatsby-transformer-remark": "^6.16.0",
    "googleapis": "^182.0.0",
    "prop-types": "^15.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/eslint-parser": "^7.29.9",
    "@babel/preset-react": "^7.29.7",
    "@types/node": "^24.19.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-wesbos": "^4.3.2",
    "eslint-plugin-html": "^8.2.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "linkinator": "^8.1.0",
    "netlify-cli": "^27.10.1",
    "prettier": "^3.9.9",
    "start-server-and-test": "^3.0.12"
  }
}
